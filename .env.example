# Copy this file to `.env` and fill in your Zamphire + Firebase values.

# ── Store (used for the online/Raast QR payment) ────────────────
VITE_STORE_NAME=Zamphire
VITE_STORE_IBAN=
VITE_ADMIN_EMAILS=

# ── Firebase project ──────────────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
